# ── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Источники для CORS через запятую
CORS_ORIGIN=http://localhost:5173

# ── MySQL ────────────────────────────────────────────────────────────────────
# MySQL 8 по умолчанию использует caching_sha2_password. Драйвер должен получить
# публичный ключ сервера, иначе подключение падает с 08S01. Для локальной разработки
# по открытому каналу это делается флагом allowPublicKeyRetrieval.
# В проде вместо него включай TLS (sslMode=verify-full) и флаг убирай.
DATABASE_URL="mysql://media:media@localhost:3306/media_pipeline?allowPublicKeyRetrieval=true"

# Теневая база для команды migrate dev — только для локальной разработки.
# Она пересоздаёт в ней схему с нуля, поэтому нужен пользователь с правами
# на создание таблиц. На сервере выполняется migrate deploy, ему это не нужно.
SHADOW_DATABASE_URL="mysql://root:root@localhost:3306/media_pipeline_shadow?allowPublicKeyRetrieval=true"

# ── Redis: этап M2, нужен только воркеру ─────────────────────────────────────
# Раскомментировать вместе с сервисом redis в docker-compose.yml.
# REDIS_URL="redis://localhost:6379"

# ── Объектное хранилище (MinIO, S3-совместимое) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Telegram (этап M4) ───────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# ── SMTP (Mailpit в разработке) ──────────────────────────────────────────────
# SMTP_HOST=localhost
# SMTP_PORT=1025

# ── JWT (этап M1) ────────────────────────────────────────────────────────────
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
