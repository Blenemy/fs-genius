// Начиная с Prisma 7 строка подключения задаётся не здесь, а в prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Пользователь. Пока минимальный набор полей — этого достаточно,
/// чтобы проверить, что миграции доезжают до сервера и база отвечает.
/// На этапе M1 сюда добавятся passwordHash, role и quotaBytes (README §5).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
