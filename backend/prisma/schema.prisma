// Начиная с Prisma 7 строка подключения задаётся не здесь, а в prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Тариф пользователя. Пока ни на что не влияет — нужен как поле,
/// по которому можно фильтровать тяжёлый отчёт.
enum Plan {
  FREE
  PRO
  ENTERPRISE
}

/// Роль пользователя (README §5). Пока ролями ничего не закрыто,
/// но она попадает в access-токен, чтобы не ходить за ней в базу.
enum Role {
  USER
  ADMIN
}

enum UploadStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

/// Пользователь.
///
/// Часть полей (bio, company, country) существует ради демонстрации кеша:
/// по ним идёт поиск без индекса, чтобы отчёт получался честно тяжёлым.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// Argon2id целиком, вместе с параметрами и солью: $argon2id$v=19$m=…$…
  passwordHash String @db.VarChar(255)
  role         Role   @default(USER)

  plan      Plan     @default(FREE)
  isActive  Boolean  @default(true)
  /// Умолчание появилось вместе с регистрацией: форма спрашивает только
  /// почту, имя и пароль. Сид и отчёт заполняют эти поля сами.
  country   String   @default("") @db.VarChar(2)
  city      String   @default("") @db.VarChar(80)
  company   String?  @db.VarChar(120)
  /// Свободный текст: по нему идёт LIKE '%...%', индекс здесь не помогает.
  bio       String?  @db.Text
  avatarUrl String?  @db.VarChar(255)

  /// Байты считаются агрегатом по загрузкам, но лежат и здесь —
  /// чтобы было с чем сравнить результат тяжёлого запроса.
  quotaBytes  BigInt    @default(1073741824)
  lastLoginAt DateTime?

  uploads       Upload[]
  refreshTokens RefreshToken[]

  @@index([createdAt])
}

/// Выданный refresh-токен. В базе лежит sha256 от JWT, а не сам JWT:
/// дамп таблицы не даёт войти.
///
/// Строки не удаляются, а помечаются revokedAt. Удалённую строку не отличить
/// от никогда не существовавшей, а на этой разнице стоит детект кражи: если
/// предъявлен уже отозванный токен, гасится вся цепочка familyId.
model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256(token) в hex — ровно 64 символа.
  tokenHash String @unique @db.Char(64)
  /// Общий id цепочки ротаций (randomUUID — 36 символов).
  familyId  String @db.VarChar(36)

  expiresAt DateTime
  revokedAt DateTime?
  /// id строки-преемника. По нему видно, что токен отозван ротацией, а не
  /// выходом, — и что две вкладки, обновившиеся разом, это не кража.
  replacedById String?

  userAgent String?  @db.VarChar(255)
  /// 45 символов — столько занимает IPv6 в текстовом виде.
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Загрузка пользователя. Настоящая работа с медиа появится на M1–M3,
/// пока это источник строк для агрегатов в отчёте.
model Upload {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      MediaKind
  status    UploadStatus @default(DONE)
  sizeBytes BigInt
  /// Длительность в миллисекундах — только у видео и аудио.
  durationMs Int?
  title      String   @db.VarChar(160)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum AssetStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

/// Тип файла по содержимому, не по расширению. Ставит стадия probe.
enum AssetKind {
  IMAGE
  VIDEO
}

/// Что делает задача. Очередь BullMQ выбирается по типу, не наоборот.
enum JobType {
  PROBE
  IMAGE_VARIANTS
  VIDEO_TRANSCODE
  AUDIO_EXTRACT
}

/// Состояние задачи в MySQL. Прогресс процентами сюда не пишем на каждый тик —
/// только снимок на смене статуса. Живой процент живёт в Redis.
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELED
}

/// Вариант файла после обработки. Байты в MinIO, здесь только ключ и мета.
enum DerivKind {
  THUMBNAIL
  PREVIEW
  POSTER
  VIDEO_720P
  AUDIO_MP3
}

/// Файл пользователя. id — cuid Prisma, он же кусок ключа в MinIO.
model Asset {
  id           String      @id @default(cuid())
  userId       String      @default("local-dev")
  originalName String      @db.VarChar(255)
  contentType  String      @db.VarChar(100)
  sizeBytes    BigInt
  storageKey   String      @unique
  status       AssetStatus @default(PENDING)

  /// Поля ниже заполняет probe, не клиент и не presign.
  kind       AssetKind?
  width      Int?
  height     Int?
  durationMs Int?
  codec      String?    @db.VarChar(50)
  bitrate    Int?

  createdAt    DateTime    @default(now())

  jobs        Job[]
  derivatives Derivative[]

  @@index([userId])
  @@index([status])
}

/// Единица работы над активом. Переживает рестарт воркера — в отличие от
/// задачи BullMQ, которая живёт в Redis. queueJobId связывает две стороны:
/// отмена ещё в очереди идёт через BullMQ, статус после рестарта — отсюда.
model Job {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  type       JobType
  status     JobStatus @default(QUEUED)
  /// Снимок 0..100 на переходе статуса, не на каждый процент ffmpeg.
  progress   Int       @default(0)
  attempts   Int       @default(0)
  error      String?   @db.Text
  presetKey  String?   @db.VarChar(50)
  /// id задачи в BullMQ. Нужен, чтобы снять её из очереди, пока воркер не взял.
  queueJobId String?   @db.VarChar(100)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  derivatives Derivative[]

  @@index([assetId])
  @@index([status, createdAt])
}

model Derivative {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Какая задача породила файл. SetNull: историю джобы можно чистить, байты остаются.
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  kind       DerivKind
  storageKey String    @unique
  mimeType   String    @db.VarChar(100)
  sizeBytes  BigInt
  width      Int?
  height     Int?
  createdAt  DateTime  @default(now())

  @@unique([assetId, kind])
  @@index([assetId])
}
