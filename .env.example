# Окружение для docker compose: и для подстановки в сам compose-файл,
# и для контейнера api.
#
#   cp .env.example .env && chmod 600 .env
#
# Файл .env в git не попадает.
#
# ВАЖНО: это окружение КОНТЕЙНЕРОВ — здесь хост базы называется "mysql"
# (имя сервиса в compose). Когда бэкенд запускается с хоста через npm run dev,
# он читает backend/.env, где хост — localhost. Это два разных файла.

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=смени-меня
MYSQL_DATABASE=media_pipeline
MYSQL_USER=media
MYSQL_PASSWORD=смени-меня-тоже

# Пароль здесь должен совпадать с MYSQL_PASSWORD выше. Если разойдутся,
# MySQL поднимется здоровым, а api будет падать на подключении.
#
# allowPublicKeyRetrieval нужен, потому что MySQL 8 использует
# caching_sha2_password, а канал внутри сети Docker не шифрован.
# Порт наружу не опубликован — он привязан к 127.0.0.1.
DATABASE_URL="mysql://media:смени-меня-тоже@mysql:3306/media_pipeline?allowPublicKeyRetrieval=true"

# ── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Сверяется не только CORS, но и checkOrigin: сюда нужен ровно тот origin,
# что шлёт браузер, вместе со схемой и портом. Расхождение выглядит как
# поломка авторизации — 403 BAD_ORIGIN на каждый POST и больше нигде.
CORS_ORIGIN=https://topchyidev.shop

# Сколько прокси-хопов перед api. На проде их два: хостовый nginx и тот,
# что в образе web. Больше реального = адрес клиента можно подделать через
# X-Forwarded-For, меньше = все клиенты выглядят одним адресом.
TRUST_PROXY=2

# ── Redis ────────────────────────────────────────────────────────────────────
# И api, и worker. Внутри Docker-сети хост — имя сервиса.
REDIS_URL="redis://redis:6379"

# ── Хранилище: этап M1 ───────────────────────────────────────────────────────
# Браузер ходит в хранилище НАПРЯМУЮ по presigned-ссылкам, поэтому эндпоинт
# обязан быть доступен снаружи и по https — иначе страница на https не
# отдаст загрузку из-за mixed content.
#
# На проде это внешний S3 (AWS / Cloudflare R2 / Backblaze), НЕ контейнер
# minio: он поднимается только профилем dev и слушает 127.0.0.1.
# Без этих четырёх переменных api с NODE_ENV=production не стартует.
# AWS:  https://s3.<регион>.amazonaws.com   + S3_REGION=<регион>
# R2:   https://<account_id>.r2.cloudflarestorage.com + S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# AWS работает по virtual-hosted (false). R2 и MinIO отдают S3 API по
# account-эндпоинту и требуют path-style (true).
S3_FORCE_PATH_STYLE=true

# ── JWT ──────────────────────────────────────────────────────────────────────

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECURE=true
