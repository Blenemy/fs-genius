# Окружение боевого стека (docker-compose.prod.yml).
# На сервере скопировать в .env и подставить настоящие значения:
#   cp .env.example .env && chmod 600 .env
# Файл .env в git не попадает — он в .gitignore.

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=смени-меня
MYSQL_DATABASE=media_pipeline
MYSQL_USER=media
MYSQL_PASSWORD=смени-меня-тоже

# Хост mysql — это имя сервиса в compose, не localhost.
# allowPublicKeyRetrieval нужен, потому что MySQL 8 использует caching_sha2_password,
# а канал внутри сети Docker не шифрован. Порт наружу не опубликован.
DATABASE_URL="mysql://media:смени-меня-тоже@mysql:3306/media_pipeline?allowPublicKeyRetrieval=true"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Фронт и API на одном происхождении, поэтому CORS фактически не используется.
CORS_ORIGIN=http://localhost

# ── Хранилище (этап M1) ──────────────────────────────────────────────────────
# Пока не заполняется: код ещё не обращается к S3.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
