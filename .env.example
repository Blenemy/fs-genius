# Окружение для docker compose: и для подстановки в сам compose-файл,
# и для контейнера api.
#
#   cp .env.example .env && chmod 600 .env
#
# Файл .env в git не попадает.
#
# ВАЖНО: это окружение КОНТЕЙНЕРОВ — здесь хост базы называется "mysql"
# (имя сервиса в compose). Когда бэкенд запускается с хоста через npm run dev,
# он читает backend/.env, где хост — localhost. Это два разных файла.

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=смени-меня
MYSQL_DATABASE=media_pipeline
MYSQL_USER=media
MYSQL_PASSWORD=смени-меня-тоже

# Пароль здесь должен совпадать с MYSQL_PASSWORD выше. Если разойдутся,
# MySQL поднимется здоровым, а api будет падать на подключении.
#
# allowPublicKeyRetrieval нужен, потому что MySQL 8 использует
# caching_sha2_password, а канал внутри сети Docker не шифрован.
# Порт наружу не опубликован — он привязан к 127.0.0.1.
DATABASE_URL="mysql://media:смени-меня-тоже@mysql:3306/media_pipeline?allowPublicKeyRetrieval=true"

# ── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Фронт и API на одном происхождении, поэтому CORS фактически не используется.
CORS_ORIGIN=http://localhost

# ── Redis ────────────────────────────────────────────────────────────────────
# Нужен воркеру: очереди BullMQ и канал прогресса.
REDIS_URL="redis://redis:6379"

# ── Хранилище: этап M1 ───────────────────────────────────────────────────────
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
